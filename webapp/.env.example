# Entorno de DESARROLLO de la migración — NUNCA apuntar esto al proyecto Supabase
# de producción (paqtohmxagfebeyyurlq.supabase.co). Ver docs/06-roadmap.md
# "Estrategia de entornos" y docs/00-resumen-ejecutivo.md.

# URL y clave anónima (publishable) del proyecto Supabase de DESARROLLO,
# creado en la Fase 0 como clon del esquema real (docs/03-modelo-datos.md § 3.1).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO-DE-DESARROLLO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usada SOLO por scripts locales (seed, tests de integración) que necesitan
# saltarse RLS para sembrar datos de prueba. NUNCA se usa desde código de
# Next.js que responde a una petición de usuario (Server Components/Actions).
# La Edge Function create-user tiene su propia service_role gestionada por
# Supabase (supabase secrets set), no lee este archivo.
SUPABASE_SERVICE_ROLE_KEY=
